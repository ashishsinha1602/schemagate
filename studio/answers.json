  "unpaid invoices over 90 days old": {
   "sql": "SELECT i.id,\n       i.invoice_number,\n       c.account_number,\n       p.display_name AS customer_name,\n       i.issued_on,\n       i.due_on,\n       i.currency,\n       i.total_gross,\n       COALESCE(pay.paid, 0) AS paid,\n       COALESCE(cn.credited, 0) AS credited,\n       i.total_gross - COALESCE(pay.paid, 0) - COALESCE(cn.credited, 0) AS outstanding,\n       CAST(julianday('now') - julianday(i.issued_on) AS INTEGER) AS age_days\nFROM main.billing_invoice i\nJOIN main.crm_customer c ON c.id = i.id_customer\nJOIN main.core_party p ON p.id = c.id_party\nLEFT JOIN (\n    SELECT id_invoice, SUM(amount) AS paid\n    FROM main.billing_payment\n    WHERE status = 'settled'\n    GROUP BY id_invoice\n) pay ON pay.id_invoice = i.id\nLEFT JOIN (\n    SELECT id_invoice, SUM(amount) AS credited\n    FROM main.billing_credit_note\n    GROUP BY id_invoice\n) cn ON cn.id_invoice = i.id\nWHERE julianday('now') - julianday(i.issued_on) > 90\n  AND i.total_gross - COALESCE(pay.paid, 0) - COALESCE(cn.credited, 0) > 0\nORDER BY age_days DESC, outstanding DESC",
   "columns": [
    "id",
    "invoice_number",
    "account_number",
    "customer_name",
    "issued_on",
    "due_on",
    "currency",
    "total_gross",
