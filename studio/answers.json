  "late shipments by carrier": {
   "sql": "SELECT c.id AS id_carrier,\n       c.name AS carrier_name,\n       c.scac_code,\n       COUNT(s.id) AS total_shipments,\n       SUM(CASE WHEN s.status = 'delayed'\n                 OR (s.delivered_at IS NOT NULL AND s.promised_at IS NOT NULL AND s.delivered_at > s.promised_at)\n                THEN 1 ELSE 0 END) AS late_shipments,\n       ROUND(100.0 * SUM(CASE WHEN s.status = 'delayed'\n                 OR (s.delivered_at IS NOT NULL AND s.promised_at IS NOT NULL AND s.delivered_at > s.promised_at)\n                THEN 1 ELSE 0 END) / COUNT(s.id), 2) AS late_pct\nFROM main.ship_carrier c\nJOIN main.ship_shipment s ON s.id_carrier = c.id\nGROUP BY c.id, c.name, c.scac_code\nORDER BY late_shipments DESC, carrier_name",
