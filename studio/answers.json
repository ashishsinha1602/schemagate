  "quote conversion to orders": {
   "sql": "SELECT q.id AS id_quote,\n       q.quote_number,\n       q.issued_on,\n       q.expires_on,\n       q.state,\n       q.total_net AS quote_net,\n       c.account_number,\n       c.segment,\n       COUNT(o.id) AS orders_converted,\n       CASE WHEN COUNT(o.id) > 0 THEN 1 ELSE 0 END AS is_converted,\n       SUM(COALESCE(o.total_net, 0)) AS order_net,\n       MIN(o.ordered_at) AS first_order_at,\n       SUM(COALESCE(o.total_net, 0)) - q.total_net AS net_variance\nFROM main.sales_quote q\nJOIN main.crm_customer c ON c.id = q.id_customer\nLEFT JOIN main.sales_order o ON o.id_quote = q.id\nGROUP BY q.id, q.quote_number, q.issued_on, q.expires_on, q.state, q.total_net,\n         c.account_number, c.segment\nORDER BY is_converted DESC, q.issued_on",
